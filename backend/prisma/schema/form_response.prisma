// ─────────────────────────────────────────────────────────────
// A FormResponse is a REQUEST: one filled-in instance of a FormVersion.
// Field values are stored EAV-style in FormResponseValue (see form.prisma)
// so a single table serves every form category.
// ─────────────────────────────────────────────────────────────

enum RequestStatus {
  DRAFT // being edited, not yet submitted to the approval flow
  PENDING // submitted, approval flow running
  REQUEST_CHANGES // an approver asked for changes; back to the requestor to revise or resubmit
  APPROVED // flow finished, all steps approved
  REJECTED // an approver rejected
  CANCELLED // creator cancelled
}

model FormResponse {
  id            String        @id @default(uuid())
  procedureVersionId String?
  formVersionId String
  createdById   String
  status        RequestStatus @default(DRAFT)

  // Operaton BPMN integration
  operatonProcessInstanceId   String?
  operatonProcessDefinitionId String?
  businessKey                 String?

  // Clone lineage (clone-reserve / clone-reset both set this).
  clonedFromId String?
  // How this request was cloned from its parent: "reset" | "reserve" | null.
  cloneMode    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  procedureVersion ProcedureVersion? @relation(fields: [procedureVersionId], references: [id])
  formVersion      FormVersion       @relation(fields: [formVersionId], references: [id])
  createdBy        User              @relation("RequestCreator", fields: [createdById], references: [id])
  clonedFrom       FormResponse?     @relation("RequestClone", fields: [clonedFromId], references: [id])
  clones           FormResponse[]    @relation("RequestClone")

  values          FormResponseValue[]
  documents       RequestDocument[]
  viewers         RequestViewer[]
  flowInstance    FlowInstance?
  signatureFields SignatureField[]
  comments        RequestComment[]
  actualActors    RequestActualActor[]
  projectedTasks  TaskProjection[]

  @@index([createdById])
  @@index([status])
  @@index([procedureVersionId])
  @@index([operatonProcessInstanceId])
  @@index([businessKey])
}

model RequestActualActor {
  id                 String   @id @default(uuid())
  responseId         String
  taskDefinitionKey  String
  taskName           String
  userId             String
  isOverridden       Boolean  @default(false)
  order              Int      @default(0)
  department         String?
  title              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  response FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id])

  @@index([responseId])
  @@index([userId])
  @@index([responseId, taskDefinitionKey])
  @@map("request_actual_actors")
}

model TaskProjection {
  id                 String    @id @default(uuid())
  operatonTaskId     String    @unique
  processInstanceId  String
  responseId         String
  taskDefinitionKey  String
  taskName           String
  assigneeId         String
  status             String    @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  dueDate            DateTime?
  claimedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  response FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  assignee User         @relation(fields: [assigneeId], references: [id])

  @@index([assigneeId, status])
  @@index([responseId])
  @@index([processInstanceId])
  @@map("task_projections")
}
