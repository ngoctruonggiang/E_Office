NODE_ENV=development
PORT=3000

# PostgreSQL (dev + prod). Dev matches docker-compose.dev.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devdb?schema=public"

# --- Default admin bootstrap ---
# On boot, if no admin account exists one is created from these (and the
# credentials are logged once). If omitted, defaults are admin@gafood.local /
# admin@P@ssw0rd123 — override in any real deployment.
ADMIN_EMAIL=admin@gafood.local
ADMIN_PASSWORD=admin@P@ssw0rd123

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=replace-with-strong-random-secret
JWT_REFRESH_SECRET=replace-with-another-strong-random-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# --- Document storage ---
# Where uploaded document bytes live: `disk` (local UPLOAD_DIR, default for dev)
# or `s3` (MinIO/S3 bucket below). Staging/production set this to `s3`.
STORAGE_DRIVER=disk
# Local directory for the `disk` driver.
UPLOAD_DIR=./uploads
# Top-level key prefix inside the shared bucket for this app's uploads:
#   <STORAGE_REPO_NAME>/<requestorId>/<requestId>/<file>
STORAGE_REPO_NAME=gafood

# --- Documenso signing bridge ---
# Base URL of the Documenso v1 API and a service API token (Bearer).
DOCUMENSO_API_URL=http://localhost:3333
DOCUMENSO_API_TOKEN=api_replace_me
# MinIO/S3 shared with Documenso. gafood reaches it directly on the host.
# Also used by the `s3` document storage driver above.
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=documenso
S3_ACCESS_KEY_ID=documenso
S3_SECRET_ACCESS_KEY=password
