# ─────────────────────────────────────────────────────────────
# Documenso deploy defaults — consumed by compose.yml via:
#     docker compose --env-file documenso.env up -d
#
# These are WORKING defaults so the stack comes up immediately. Override any
# value with a GitLab CI/CD variable of the same name (the job's shell env
# takes precedence over this file) — do that for the secrets before going live.
# Regenerate secrets with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────

# Public hostnames served by Traefik (godaddy resolver, same as backend/FE).
# - DOCUMENSO_HOST: the signing page (NEXT_PUBLIC_WEBAPP_URL → signingUrl).
# - DOCUMENSO_FILES_HOST: MinIO, so the signer's browser can fetch the PDF via
#   the presigned URL. Both must have DNS pointing at the Traefik host.
DOCUMENSO_HOST=sign.s2.ttpprojects.com
DOCUMENSO_FILES_HOST=files.s2.ttpprojects.com

# Optional: restrict who can reach the two hosts (see the commented IP allow-list
# labels in compose.yml). Comma-separated CIDRs, e.g. 203.0.113.0/24,198.51.100.7/32
# TRUSTED_IPS=

# Dedicated Postgres for Documenso (NOT the gafood eofficedb).
POSTGRES_USER=documenso
POSTGRES_PASSWORD=change-me-documenso-db-password
POSTGRES_DB=documenso

# App secrets — generate real values with: openssl rand -base64 32
# Set these as MASKED CI/CD variables (Settings → CI/CD → Variables).
NEXTAUTH_SECRET=gafood-documenso-nextauth-secret-replace-me!
NEXT_PRIVATE_ENCRYPTION_KEY=gafood-documenso-enc-key-1-replace-me!
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=gafood-documenso-enc-key-2-replace-me!

# Object storage (MinIO). The gafood backend uses the SAME credentials/bucket
# (S3_* in the backend pipeline) to read/write signed documents.
NEXT_PRIVATE_UPLOAD_REGION=us-east-1
NEXT_PRIVATE_UPLOAD_BUCKET=documenso
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID=documenso
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY=password

# Email is DISABLED (internal-only signing surfaces the link via the gafood FE).
# Documenso requires a transport + from identity to boot; these are inert
# placeholders — the backend sends with sendEmail:false so no mail is attempted.
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_FROM_NAME=Documenso
NEXT_PRIVATE_SMTP_FROM_ADDRESS=noreply@s2.ttpprojects.com

# Document signing certificate (.p12) as a base64 string. Leave empty to boot
# without signing. Generate with:
#   openssl base64 -A -in cert.p12
NEXT_PRIVATE_SIGNING_LOCAL_FILE_CONTENTS=
NEXT_PRIVATE_SIGNING_PASSPHRASE=

# No UI signups — only the seeded backend service user exists; signers use
# tokenized links and need no account.
NEXT_PUBLIC_DISABLE_SIGNUP=true
